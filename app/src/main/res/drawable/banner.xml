<?xml version="1.0" encoding="utf-8"?>
<!-- Banner provisorio del launcher (320x180). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp" android:height="180dp">
    <item><color android:color="#2B211B" /></item>
    <item android:gravity="center" android:width="140dp" android:height="140dp">
        <shape android:shape="oval"><solid android:color="#141110" /></shape>
    </item>
    <item android:gravity="center" android:width="48dp" android:height="48dp">
        <shape android:shape="oval"><solid android:color="#B8894A" /></shape>
    </item>
</layer-list>
